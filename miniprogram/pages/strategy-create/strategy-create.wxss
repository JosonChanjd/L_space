/* 指标公式策略表单 · 页面局部样式（通用设计系统见 app.wxss） */

.form-item {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 24rpx;
  color: var(--muted, #8e99a8);
}

.input {
  width: 100%;
  box-sizing: border-box;
  height: 76rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--border, #e3e7ef);
  border-radius: 14rpx;
  background: var(--field-bg, #f6f7fb);
  color: var(--text, #1f2430);
  font-size: 28rpx;
}

.picker {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--border, #e3e7ef);
  border-radius: 14rpx;
  background: var(--field-bg, #f6f7fb);
  color: var(--text, #1f2430);
  font-size: 28rpx;
}

.formula-editor {
  width: 100%;
  box-sizing: border-box;
  min-height: 150rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--border, #e3e7ef);
  border-radius: 14rpx;
  background: var(--field-bg, #f6f7fb);
  color: var(--text, #1f2430);
  font-family: Menlo, Consolas, monospace;
  font-size: 24rpx;
  line-height: 1.6;
  word-break: break-all;
}

.formula-hint {
  display: block;
  margin: 12rpx 0 4rpx;
  line-height: 1.6;
}

.asset-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--brand-ring, #ffd0c2);
  border-radius: 14rpx;
  background: var(--brand-soft, #fff1ed);
}

.asset-main {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.asset-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text, #1f2430);
}

.asset-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.suggest {
  margin-top: 8rpx;
  border: 1rpx solid var(--border, #e3e7ef);
  border-radius: 14rpx;
  background: var(--card, #ffffff);
  overflow: hidden;
}

.suggest-row {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid var(--border, #edf0f5);
}

.suggest-row:last-child {
  border-bottom: 0;
}

.suggest-name {
  font-size: 26rpx;
  color: var(--text, #1f2430);
}

.suggest-sub {
  line-height: 1.4;
}

.suggest-tip {
  margin-top: 8rpx;
}

.trade-scroll {
  width: 100%;
}

.trade-table {
  min-width: 1000rpx;
}

.trade-table .table-cell {
  padding: 12rpx 10rpx;
  font-size: 22rpx;
  text-align: right;
  white-space: nowrap;
}

.trade-table .table-cell:first-child {
  text-align: left;
}

.preview-note {
  display: block;
  margin-top: 12rpx;
  line-height: 1.6;
}

.foot-note {
  padding: 24rpx 24rpx 48rpx;
  line-height: 1.6;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text, #1f2430);
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.toolbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

.toolbar .btn {
  flex: 1 1 40%;
}
