/* 自选页页面私有样式 */
.search-bar {
  position: relative;
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1 1 auto;
  padding-right: 72rpx;
}

.search-clear {
  position: absolute;
  right: 18rpx;
  top: 50%;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--border);
  color: var(--muted);
  font-size: 22rpx;
  transform: translateY(-50%);
}

.search-tip {
  margin-top: 14rpx;
}

.search-result {
  margin-top: 12rpx;
  border-top: 2rpx solid var(--border);
}

.search-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--border);
}

.search-item:last-child {
  border-bottom: none;
}

.search-main {
  flex: 1 1 auto;
  min-width: 0;
}

.search-name {
  color: var(--text);
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.search-meta {
  display: flex;
  align-items: center;
  margin-top: 6rpx;
}

.search-tag {
  margin-left: 12rpx;
}

.watch-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--border);
}

.watch-row:last-of-type {
  border-bottom: none;
}

.watch-main {
  flex: 1 1 auto;
  min-width: 0;
}

.watch-name {
  display: flex;
  align-items: center;
  min-width: 0;
}

.watch-title {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--text);
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.4;
}

.watch-badge {
  flex: 0 0 auto;
  margin-left: 10rpx;
}

.watch-meta {
  display: flex;
  align-items: center;
  margin-top: 6rpx;
}

.watch-date {
  margin-left: 12rpx;
}

.watch-side {
  flex: 0 0 auto;
  margin-left: 16rpx;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

.watch-price {
  color: var(--text);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
}

.watch-pct {
  margin-top: 2rpx;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.3;
}

.watch-refresh {
  margin-top: 18rpx;
  width: 100%;
}
