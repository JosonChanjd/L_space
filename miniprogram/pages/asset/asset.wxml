<view class="page">
  <loading wx:if="{{loading}}" text="正在加载资产数据…" />

  <view class="card" wx:elif="{{error}}">
    <view class="error-box">{{error}}</view>
    <button class="btn-primary" bindtap="onRetry">重试</button>
  </view>

  <block wx:else>
    <!-- 股票行情 -->
    <view class="card" wx:if="{{stock}}">
      <view class="asset-head">
        <view class="asset-name">{{stock.name}}</view>
        <view class="mono sm muted">{{stock.code}}</view>
      </view>
      <view class="asset-price {{stock.dir}}">
        {{stock.priceText}}
        <text class="asset-unit" wx:if="{{stock.unit}}">{{stock.unit}}</text>
      </view>
      <view class="asset-pct {{stock.dir}}">{{stock.changeText}} · {{stock.pctText}}</view>
      <view class="grid-2 asset-kv">
        <view class="asset-kv-item"><text class="muted sm">今开</text><text class="mono">{{stock.openText}}</text></view>
        <view class="asset-kv-item"><text class="muted sm">昨收</text><text class="mono">{{stock.prevCloseText}}</text></view>
        <view class="asset-kv-item"><text class="muted sm">最高</text><text class="mono up">{{stock.highText}}</text></view>
        <view class="asset-kv-item"><text class="muted sm">最低</text><text class="mono down">{{stock.lowText}}</text></view>
        <view class="asset-kv-item"><text class="muted sm">52周最高</text><text class="mono">{{stock.high52Text}}</text></view>
        <view class="asset-kv-item"><text class="muted sm">52周最低</text><text class="mono">{{stock.low52Text}}</text></view>
      </view>
    </view>

    <!-- 基金详情 -->
    <block wx:if="{{fund}}">
      <view class="card">
        <view class="asset-head">
          <view class="asset-name">{{fund.name}}</view>
          <view class="mono sm muted">{{fund.code}}</view>
        </view>
        <view class="asset-price {{fund.dir}}">{{fund.navText}}</view>
        <view class="asset-pct {{fund.dir}}">
          {{fund.pctText}}
          <text class="muted sm" wx:if="{{fund.navDate}}">· 净值日期 {{fund.navDate}}</text>
        </view>
        <view class="section-title">阶段收益</view>
        <view class="grid-3">
          <view class="stage-item" wx:for="{{fund.stageRows}}" wx:key="label">
            <view class="muted xs">{{item.label}}</view>
            <view class="stage-value {{item.dir}}">{{item.text}}</view>
          </view>
        </view>
        <view class="section-title">风险指标</view>
        <view class="grid-2">
          <view class="risk-item" wx:for="{{fund.riskRows}}" wx:key="label">
            <view class="muted xs">{{item.label}}</view>
            <view class="risk-value">{{item.text}}</view>
          </view>
        </view>
      </view>

      <view class="card">
        <view class="card-head">
          <text class="card-title">基金经理</text>
        </view>
        <view class="row">
          <view class="muted">经理</view>
          <view class="fund-manager">
            <text>{{fund.managerName}}</text>
            <text class="fund-star" wx:if="{{fund.managerStar}}">{{fund.managerStar}}</text>
          </view>
        </view>
        <view class="row">
          <view class="muted">任职 / 管理规模</view>
          <view class="fund-manager-meta">{{fund.managerMeta || '—'}}</view>
        </view>
        <view class="row">
          <view class="muted">基金规模</view>
          <view class="fund-manager-meta">{{fund.scaleText}}</view>
        </view>
      </view>

      <view class="card" wx:if="{{fund.holdings.length}}">
        <view class="card-head">
          <text class="card-title">前十大持仓</text>
          <text class="section-sub">按季报</text>
        </view>
        <view class="row holding-row" wx:for="{{fund.holdings}}" wx:key="name">
          <view class="holding-name">{{item.name}}</view>
          <view class="holding-weight">{{item.weightText}}</view>
        </view>
      </view>
    </block>

    <!-- 走势图 -->
    <view class="card" wx:if="{{!chartEmpty}}">
      <view class="card-head">
        <text class="card-title">{{stock ? '价格走势' : '单位净值走势'}}</text>
      </view>
      <line-chart
        series="{{chartSeries}}"
        height="{{220}}"
        percent="{{chartPercent}}"
        markers="{{chartMarkers}}"
      />
    </view>

    <!-- 说明 -->
    <view class="card" wx:if="{{note}}">
      <view class="muted sm">{{note}}</view>
    </view>

    <view class="muted xs asset-foot">数据来自公开行情接口，仅供参考，不构成投资建议。</view>
  </block>
</view>
