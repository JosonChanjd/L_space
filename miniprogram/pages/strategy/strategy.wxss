/* 策略首页 · 页面局部样式（通用设计系统见 app.wxss） */

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text, #1f2430);
}

.toolbar-main {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.list-card {
  padding: 0 24rpx;
}

.tpl-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border, #edf0f5);
}

.tpl-row:last-child {
  border-bottom: 0;
}

.row-hover {
  background: var(--panel, #f6f7fb);
}

.tpl-icon {
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: var(--brand-soft, #fff1ed);
  font-size: 36rpx;
  line-height: 1;
}

.tpl-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.tpl-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text, #1f2430);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tpl-desc {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.5;
}

.tpl-meta {
  line-height: 1.4;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.arrow {
  flex: 0 0 auto;
  color: var(--muted, #8e99a8);
  font-size: 34rpx;
  line-height: 1;
}

.foot-note {
  padding: 24rpx 24rpx 48rpx;
  line-height: 1.6;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text, #1f2430);
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.toolbar .btn-mini {
  flex: 0 0 auto;
}
