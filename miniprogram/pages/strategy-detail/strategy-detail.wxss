/* 策略详情 · 页面局部样式（通用设计系统见 app.wxss） */

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.hero-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hero-badges {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.hero-label {
  font-size: 24rpx;
  color: var(--muted, #8e99a8);
}

.hero-value {
  font-size: 60rpx;
  font-weight: 700;
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
}

.hero-sub {
  line-height: 1.5;
}

.hero-desc {
  line-height: 1.5;
}

.chips-tip {
  margin-left: 12rpx;
  align-self: center;
}

.note-text {
  display: block;
  line-height: 1.6;
}

.kv-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx 24rpx;
  margin-top: 20rpx;
}

.kv {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.kv-value {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text, #1f2430);
  word-break: break-all;
}

.signal-note {
  display: block;
  margin-top: 16rpx;
  line-height: 1.6;
}

.tab-note {
  display: block;
  margin-top: 16rpx;
  line-height: 1.6;
}

.formula-label {
  display: block;
  margin: 20rpx 0 8rpx;
  font-size: 22rpx;
  color: var(--muted, #8e99a8);
}

.formula {
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--border, #e3e7ef);
  border-radius: 14rpx;
  background: var(--field-bg, #f6f7fb);
  color: var(--text, #1f2430);
  font-family: Menlo, Consolas, monospace;
  font-size: 24rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}

.trade-scroll {
  width: 100%;
  margin-top: 16rpx;
}

.trade-table {
  min-width: 1100rpx;
}

.trade-table .table-cell {
  padding: 12rpx 10rpx;
  font-size: 22rpx;
  text-align: right;
  white-space: nowrap;
}

.trade-table .table-cell:first-child {
  text-align: left;
}

.foot-note {
  padding: 24rpx 24rpx 48rpx;
  line-height: 1.6;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text, #1f2430);
}

.toolbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
}

.toolbar .btn {
  flex: 1 1 40%;
}
