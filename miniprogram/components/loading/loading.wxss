/* 加载态组件局部样式 */
.c-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 24rpx;
  color: #8e99a8;
}

.c-loading-dots {
  display: flex;
  align-items: center;
  justify-content: center;
}

.c-loading-dot {
  width: 12rpx;
  height: 12rpx;
  margin: 0 6rpx;
  border-radius: 50%;
  background: #ff5b3a;
  animation: c-loading-bounce 1.2s ease-in-out infinite;
}

.c-loading-dot:nth-child(2) {
  animation-delay: 0.15s;
}

.c-loading-dot:nth-child(3) {
  animation-delay: 0.3s;
}

.c-loading-text {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.4;
}

@keyframes c-loading-bounce {
  0%, 100% {
    transform: translateY(0);
    opacity: 0.5;
  }
  50% {
    transform: translateY(-10rpx);
    opacity: 1;
  }
}
